<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    android:layout_marginTop="15dp"
    app:cardCornerRadius="6dp"
    android:id="@+id/venuesCardCView"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/stadiumImg"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"
            android:scaleType="fitXY"
            android:src="@drawable/stadium8_edengaden" />

        <TextView
            android:id="@+id/stadiumName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/arbutus"
            android:text="M. Chinnaswamy Stadium"
            android:textColor="#D32F2F"
            android:textSize="16sp"
            android:textStyle="normal" />

        <TableLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="10dp">

            <TableRow
                android:weightSum="10"
                android:layout_gravity="left"
                android:background="@color/colorPrimary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="match_parent"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginLeft="1dp"
                    android:background="#ffffff"
                    android:paddingLeft="25dp"
                    android:paddingTop="1dp"
                    android:paddingRight="25dp"
                    android:paddingBottom="1dp"
                    android:text="Home Team "
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:id="@+id/stadiumHometeam"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="25dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginBottom="0dp"
                    android:background="#ffffff"
                    android:paddingLeft="25dp"
                    android:paddingRight="20dp"
                    android:text="Mumbai Indians"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorPrimary" />

            </TableRow>

            <TableRow
                android:weightSum="10"
                android:layout_gravity="left"
                android:background="@color/colorPrimary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="match_parent"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginLeft="1dp"
                    android:background="#ffffff"
                    android:paddingLeft="25dp"
                    android:paddingTop="1dp"
                    android:paddingRight="25dp"
                    android:paddingBottom="1dp"
                    android:text="Location"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:id="@+id/stadiumLocation"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginBottom="0dp"
                    android:background="#ffffff"
                    android:paddingLeft="25dp"
                    android:paddingRight="20dp"
                    android:text="Mumbai, India"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorPrimary" />

            </TableRow>

            <TableRow
                android:weightSum="10"
                android:layout_gravity="left"
                android:background="@color/colorPrimary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="4"
                    android:layout_height="match_parent"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginLeft="1dp"
                    android:background="#ffffff"
                    android:paddingLeft="25dp"
                    android:paddingTop="1dp"
                    android:paddingRight="25dp"
                    android:paddingBottom="1dp"
                    android:text="Opened"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/stadiumOpened"
                    android:layout_width="0dp"
                    android:layout_weight="6"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginBottom="0dp"
                    android:background="#ffffff"
                    android:paddingLeft="25dp"
                    android:paddingRight="20dp"
                    android:text="1974"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorPrimary" />

            </TableRow>

            <TableRow
                android:layout_gravity="left"
                android:layout_marginBottom="20dp"
                android:background="@color/colorPrimary"
                android:weightSum="10">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginLeft="1dp"
                    android:layout_marginBottom="1dp"
                    android:background="#ffffff"
                    android:paddingLeft="25dp"
                    android:paddingTop="1dp"
                    android:paddingRight="25dp"
                    android:paddingBottom="1dp"
                    android:text="Capacity"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/stadiumCapacity"
                    android:layout_width="165dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginBottom="1dp"
                    android:background="#ffffff"
                    android:paddingLeft="25dp"
                    android:paddingRight="20dp"
                    android:text="45,000"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/colorPrimary" />

            </TableRow>

        </TableLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>