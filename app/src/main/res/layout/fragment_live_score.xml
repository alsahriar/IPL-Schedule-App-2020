<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragment.LiveScore"
    android:orientation="vertical"
    android:id="@+id/web_container">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            style="?android:attr/progressBarStyleHorizontal"
            android:visibility="visible"/>
        <LinearLayout
            android:layout_weight="9"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/webview_layout">

            <LinearLayout
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ProgressBar

                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:visibility="visible"
                    android:layout_gravity="center" />
                <TextView
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/colorPrimary"
                    android:text="Connection to server..."/>

            </LinearLayout>

            <WebView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/webViewID"
                android:visibility="gone"/>

        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/no_internetlayout">
            <ImageView
                android:layout_marginBottom="15sp"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/no_wifi"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check your internet connection and try again"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textAlignment="center"
                android:textSize="20dp"
                android:layout_margin="25dp"/>

            <Button
                android:layout_marginTop="10dp"
                android:id="@+id/retry_btn"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:text="Retry"
                android:textSize="25dp"
                android:textStyle="bold"
                android:background="@color/colorPrimary"
                android:textColor="#ffffff"/>

        </LinearLayout>
        <!--<LinearLayout
            android:id="@+id/banner_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent" />-->
        <com.google.android.gms.ads.AdView
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView_liveScore"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:visibility="gone"
            ads:adSize="BANNER"
            ads:adUnitId="@string/admobBnrADsID">
        </com.google.android.gms.ads.AdView>


    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>